# Copy to .dev.vars for local `wrangler pages dev`, or set as Pages secrets/vars in production
# (npx wrangler pages secret put NAME --project-name chore-quest).
# The family key and parent PIN are NOT env vars: `node scripts/seed.mjs` generates them into
# .secrets.env (gitignored) and stores only their hashes in D1.

# Optional. Enables GET /api/summary (read-only, no check-offs) for a dashboard or widget.
# Use a long random value, e.g. `openssl rand -hex 32`. Leave unset to disable the endpoint.
DASHBOARD_READ_KEY=

# Optional. Comma-separated browser origins allowed to call /api/summary via CORS.
DASHBOARD_ORIGINS=https://dashboard.example.com

# Testing only. Never set in production: lets requests fake the clock with an x-test-now header.
# ALLOW_TEST_CLOCK=1
